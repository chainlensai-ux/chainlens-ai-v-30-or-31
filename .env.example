# ChainLens AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is excluded by .gitignore.

# ── Vercel KV (Token Scanner response cache, lib/server/cache/tokenCache.ts) ───
# Provision a Vercel KV store and these are auto-populated by Vercel; without them,
# the token cache silently no-ops (Token Scanner still works, just uncached).
KV_REST_API_URL=<kv-rest-api-url>
KV_REST_API_TOKEN=<kv-rest-api-token>

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional: direct DB URL (only needed for migrations)
# SUPABASE_URL=postgresql://...

# ── Anthropic (Clark AI) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Blockchain / Data providers ───────────────────────────────────────────────
ZERION_KEY=<zerion-api-key>
GOLDRUSH_API_KEY=<goldrush-key>
# FOMO board (Whale Alerts "FOMO board" tab) — read only by lib/server/fomoApi.ts, called only
# from app/api/fomo/leaderboard/route.ts (10-minute server-side cache). Never sent to the browser —
# do NOT prefix with NEXT_PUBLIC_. Without it, the FOMO board tab shows an "unconfigured" state;
# the existing Activity feed/filters/sync are entirely unaffected.
FOMO_API_KEY=<fomo-api-key>
# Optional — CoinGecko demo API key, used as the x-cg-demo-api-key header by the wallet scanner's
# multi-provider historical pricing fallback (src/modules/pricingAtTimeEngine/sources/
# multiProviderPriceSource.ts). Works without it too (public rate limits apply).
COINGECKO_API_KEY=<coingecko-demo-api-key>
# Alchemy RPC keys — Base is required for LP burn/lock proof; ETH/Polygon/BNB are optional.
# Set either ALCHEMY_BASE_KEY (key only) or ALCHEMY_BASE_RPC_URL (full URL).
# Without ALCHEMY_BASE_KEY or ALCHEMY_BASE_RPC_URL, Base LP V2 proof falls back to
# "unverified" and _debug.lpDiagnostics.rpcSkippedReason = "missing_base_rpc_env".
ALCHEMY_BASE_KEY=<alchemy-base-key>
ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# Without ALCHEMY_ETHEREUM_KEY, ETH LP V2 proof falls back similarly
# (_debug.lpDiagnostics.rpcSkippedReason = "missing_eth_rpc_env").
ALCHEMY_ETHEREUM_KEY=<alchemy-eth-key>
ALCHEMY_POLYGON_KEY=<alchemy-polygon-key>
# Optional — Token Scanner's "basic scan" tier for BNB Chain (price/liquidity/volume/holders/market
# data via GoldRush/DexScreener/GeckoTerminal) works without this. Without it, only the RPC-backed
# checks (some holder/dev-wallet lookups) are skipped for BNB, same graceful degradation pattern as
# every other optional Alchemy key here. LP lock/burn proof is not yet supported for BNB Chain at
# all (no verified PancakeSwap position-manager/locker registry yet) regardless of this key.
ALCHEMY_BNB_KEY=<alchemy-bnb-key>
# Required for the V2 wallet scanner's Arbitrum support (src/modules/providerFetchWindow,
# recoveryPolicy, holdings). Without it, Arbitrum falls back to the same "no_api_key_configured"
# provider-unavailable handling every other chain already uses.
ALCHEMY_ARBITRUM_KEY=<alchemy-arbitrum-key>
# HyperEVM (Hyperliquid's EVM, chain ID 999) is a supported chain slug in the V2 wallet scanner's
# SupportedChain union, but neither GoldRush/Covalent nor Alchemy has a codebase-verified chain
# slug for it yet — see src/modules/providerFetchWindow/types.ts and src/modules/providerFetchWindow/
# utils.ts's ALCHEMY_VERIFIED_CHAINS/GOLDRUSH_VERIFIED_CHAIN_SLUGS. These two vars are reserved,
# not yet wired to a working request path:
#   - ALCHEMY_HYPEREVM_KEY: for whenever Alchemy adds verified HyperEVM support.
#   - HYPEREVM_RPC_URL: for a future native-RPC (eth_getLogs) fetcher, which needs a verified
#     HyperEVM block-time/block-range estimate before it can safely window a 90-day fetch — not
#     built yet (see the TODO in providerFetchWindow/types.ts).
# Until either is wired up, HyperEVM scans structurally participate in every other stage (chain
# selection, timelines, FIFO, bridge detection, behaviorIntel) but fetch zero real events.
ALCHEMY_HYPEREVM_KEY=<alchemy-hyperevm-key-reserved-not-yet-wired>
HYPEREVM_RPC_URL=<hyperevm-rpc-url-reserved-not-yet-wired>

# ── Robinhood Chain ──────────────────────────────────────────────────────────────────────────
# Robinhood Chain (chain ID 4663) — see lib/server/robinhoodChainConfig.ts. Originally wired only
# into Base Radar's chain-status flag check (app/api/base-radar/chain-status/route.ts, gated by
# BOTH vars below — the Base Radar chain selector only shows a Robinhood option when both are set).
# Token Scanner now also has a "basic scan" tier for Robinhood Chain (price/liquidity/volume/
# holders/market data via GoldRush/DexScreener/GeckoTerminal) that does NOT require either var
# below — those providers are queried directly by chain slug, no Alchemy RPC involved. These two
# vars only gate: (a) the Base Radar chain selector, and (b) Token Scanner's RPC-backed checks
# (getAlchemyRpcUrl reuses getRobinhoodRpcUrl() from this same module) — without
# ALCHEMY_ROBINHOOD_RPC_URL, those specific checks are skipped, same pattern as every other
# optional Alchemy key here. LP lock/burn proof (ERC-20 LP token burn detection + PinkLock lookup)
# works for standard V2-style pools on Robinhood Chain once this RPC var is set. Concentrated (V3/
# V4) position OWNERSHIP is a separate piece — see GRAPH_API_KEY below. Neither var here is ever
# sent to the browser — do NOT prefix either with NEXT_PUBLIC_.
ENABLE_ROBINHOOD_CHAIN=false
ALCHEMY_ROBINHOOD_RPC_URL=<alchemy-robinhood-rpc-url-e.g.-https://robinhood-mainnet.g.alchemy.com/v2/key>

# BLOCKSCOUT_API_KEY, DISCLOSED (Robinhood Wallet Scanner Blockscout integration task): an explorer/
# indexer PROOF-LAYER key for lib/server/robinhoodBlockscoutEvidence.ts — never a replacement for
# GoldRush (balances/activity) or ALCHEMY_ROBINHOOD_RPC_URL (native balance, pool-currency/decimals
# RPC reads) above. Only ever consulted as a fallback (GoldRush transactions_v3 failed entirely) or
# a verification source (a log GoldRush reported is missing raw topics/data the Robinhood V4 swap
# decoder needs) for Robinhood Chain — never used for Base/ETH/BNB or Solana. Robinhood Chain's
# public Blockscout REST API (robinhoodchain.blockscout.com) answers reads without a key; this key
# only raises this deployment's own rate/credit ceiling, appended as a query param. Requires
# ENABLE_ROBINHOOD_CHAIN=true and ALCHEMY_ROBINHOOD_RPC_URL to also be set — without a real
# BLOCKSCOUT_API_KEY, this feature stays honestly off (isRobinhoodBlockscoutConfigured() false), the
# same "missing config -> clean degrade, never a guess" pattern every other optional key here uses.
BLOCKSCOUT_API_KEY=<blockscout-api-key-optional-explorer-fallback-for-robinhood-wallet-scanner>

# ── Solana Beta (Token Scanner only) ─────────────────────────────────────────────────────────
# Adds a SEPARATE "Solana Beta" scan path to Token Scanner. It is NOT parity with Base/Ethereum/
# BNB and never claims to be: honeypot simulation, buy/sell tax simulation, ERC-20 LP lock/burn
# proof, contract-owner reads and deployer history are all EVM-specific and are reported as
# explicitly unsupported on this path rather than as passed checks.
#
# What Solana Beta DOES read: mint identity (decimals, supply, mint/freeze authority, which SPL
# token program owns the mint) from the mint account, top-ACCOUNT concentration via
# getTokenLargestAccounts (max 20 token accounts — NOT a holder count, and pool vaults are
# included), and market data from DexScreener (already a wired provider — no new or paid API).
#
# BOTH vars are required for the Solana Beta chain option to appear at all. Setting the flag
# without an RPC URL yields "Solana Beta is not configured yet." rather than silently falling back
# to a rate-limited public endpoint. ALCHEMY_SOLANA_RPC_URL embeds an API key and is never sent to
# the browser — do NOT prefix it with NEXT_PUBLIC_.
ENABLE_SOLANA_BETA=false
ALCHEMY_SOLANA_RPC_URL=<alchemy-solana-rpc-url-e.g.-https://solana-mainnet.g.alchemy.com/v2/key>

# Solana Beta — optional provider enrichment (Solana provider wiring task). Both are OFF by
# default; each is only called when its own flag is "true" AND (for Helius) its key is present.
# Missing/disabled either one never crashes a Solana scan — it just shows as an evidence gap.
#
# Jupiter (lite-api.jup.ag): token identity (name/symbol/logo/verified) + price fallback. The
# endpoints used here are public and work without a key — JUPITER_API_KEY only raises rate limits.
ENABLE_JUPITER_SOLANA=false
JUPITER_API_KEY=<optional-jupiter-api-key>

# Helius: a lightweight getSignaturesForAddress RPC call used only as an on-chain-activity signal,
# plus a paginated getTokenAccounts read (capped at 3 pages of 1000) for a real holder-account
# count. Never calls the paid Enhanced Transactions API (no creator/dev-wallet parsing) — that
# would require a separate, explicitly gated deep-analysis path that does not exist yet.
# HELIUS_API_KEY embeds an API key and is never sent to the browser — do NOT prefix with NEXT_PUBLIC_.
ENABLE_HELIUS_SOLANA=false
HELIUS_API_KEY=<helius-api-key>

# GeckoTerminal OHLCV candles for the Solana Market tab's Price Chart — free, public, keyless
# (api.geckoterminal.com), so there is no flag or key to set here. Runs automatically whenever
# Solana Beta is enabled and a pool address is known from DexScreener.

# Uniswap V4 concentrated-liquidity position ownership on Robinhood Chain — see
# lib/server/uniswapV4Subgraph.ts. V4 pools are sub-accounts of a singleton PoolManager, not
# standalone contracts, so per-position ownership can't be resolved by RPC alone; this queries the
# official Uniswap V4 subgraph (The Graph network) instead, aggregating net liquidity per sender
# from ModifyLiquidity events (V4 has no persistent per-position "owner" field in the subgraph
# schema itself — the raw event log is the real signal). Free tier (100k queries/month) is more
# than sufficient at one query per V4-pool scan. Without either var, this feature no-ops back to
# the existing "not supported yet" state — no other Token Scanner functionality is affected.
GRAPH_API_KEY=<your-thegraph-studio-api-key>
GRAPH_UNISWAP_V4_SUBGRAPH_ID_ROBINHOOD=Gqm2b5J85n1bhCyDMpGbtbVn4935EvvdyHdHrx3dibyj

# Optional: widen the provider fetch window beyond the 90-day default (opt-in, never required).
# See src/modules/providerFetchWindow/{types,utils,index}.ts for the full disclosure. Leaving all
# three unset preserves the exact prior behavior (fixed 90-day window, [80,100] bounds).
#   PROVIDER_FETCH_WINDOW_DAYS_MIN=80          # optional — may only narrow the fixed [80,365] floor
#   PROVIDER_FETCH_WINDOW_DAYS_MAX=365         # optional — may only narrow the fixed [80,365] ceiling
#   PROVIDER_FETCH_WINDOW_OVERRIDE=180         # optional — the actual window value, clamped to the
#                                               # (possibly narrowed) [min, max] above; unset = 90
# Widening this does NOT enable deep-paging (still a single bounded page per provider per chain) —
# a very active wallet's older history within a wider window can still be truncated by that one page.
# Optional explorer keys (fallback chain data)
BASESCAN_API_KEY=<basescan-key>
ETHERSCAN_API_KEY=<etherscan-key>
# Optional: GoPLus token safety
GOPLUS_APP_KEY=<goplus-key>
GOPLUS_APP_SECRET=<goplus-secret>

# ── WalletConnect ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<walletconnect-project-id>
# Fallback name (some integrations use WALLETCONNECT_ID)
NEXT_PUBLIC_WALLETCONNECT_ID=<walletconnect-project-id>

# ── Payments ──────────────────────────────────────────────────────────────────
# NowPayments crypto checkout
NOWPAYMENTS_API_KEY=<nowpayments-api-key>
NOWPAYMENTS_IPN_SECRET=<nowpayments-ipn-secret>
# PayPal (fiat — recurring Subscriptions, see docs/paypal-verification.md). Requires two Billing
# Plans created ahead of time in the PayPal Developer Dashboard, and a webhook subscribed to
# BILLING.SUBSCRIPTION.CREATED / ACTIVATED / CANCELLED and PAYMENT.SALE.COMPLETED, pointed at
# https://www.chainlensai.app/api/paypal/webhook (or the preview domain for testing).
PAYPAL_CLIENT_ID=<paypal-rest-app-client-id>
PAYPAL_CLIENT_SECRET=<paypal-rest-app-client-secret>
# 'live' or 'sandbox' — selects api-m.paypal.com vs api-m.sandbox.paypal.com
PAYPAL_ENV=live
PAYPAL_PRO_PLAN_ID=<paypal-billing-plan-id-for-pro>
PAYPAL_ELITE_PLAN_ID=<paypal-billing-plan-id-for-elite>
PAYPAL_SUBSCRIPTIONS_WEBHOOK_ID=<paypal-webhook-id>

# ── Email / Notifications ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...
AFFILIATE_FROM_EMAIL=affiliates@chainlensai.app
AFFILIATE_NOTIFY_EMAIL=team@chainlensai.app

# ── Webhooks ──────────────────────────────────────────────────────────────────
ALCHEMY_WEBHOOK_SIGNING_KEY=<alchemy-webhook-signing-key>
# Set to "true" to enable background webhook processing
WEBHOOKS_ENABLED=true

# ── Wallet scan ──────────────────────────────────────────────────────────────
# QSTASH/WORKER REMOVAL, DISCLOSED: this project previously ran full scans through a QStash-
# triggered background worker (WORKER_ENDPOINT, SCAN_WORKER_SECRET, QSTASH_URL/QSTASH_TOKEN/
# QSTASH_CURRENT_SIGNING_KEY/QSTASH_NEXT_SIGNING_KEY). That entire system has been removed — full
# scans (app/api/scan-v2/full-scan/legacy/route.ts) now run synchronously in the same request, no
# queue, no worker, no separate secret/signature layer. None of the above env vars are read by
# anything anymore; remove them from any real deployment's env vars whenever convenient.

# ── Admin dashboard (/admin, app/api/admin/data & app/api/admin/actions) ───────
# Comma-separated allowlist of emails permitted to load /admin (revenue, affiliate, payment data)
# and use its actions (approve/reject affiliates, mark commissions paid). Checked against the
# signed-in Supabase user's email (case-insensitive, trimmed) — everyone else gets a 401 and the
# page shows "Admin access only". Empty/unset means NO ONE can access /admin (fails closed). This
# same list also doubles as the "internal/test" email set that's excluded from the dashboard's real
# revenue/conversion metrics. Must be set on every Vercel environment scope (Preview, Production)
# you want /admin to work on — env var changes only take effect on deployments made after saving.
ADMIN_EMAILS=<comma-separated-admin-emails>

# ── App config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.chainlensai.app
# Dev/beta override — never set to "true" in production
# BETA_ALL_ELITE=false

# ── Preview deployment password gate (proxy.ts, app/preview-login) ────────────
# Only enforced when Vercel's own VERCEL_ENV === "preview" — never on production, never locally.
# Without this set, preview-login always rejects every password (fails closed, never open).
PREVIEW_PASSWORD=<preview-deployment-password>
